PORT=4000
HOST=127.0.0.1
DB_PATH=./data/app.db
# Required in production: a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=
# OAuth "Web application" client ID from Google Cloud Console (see README → Setting up Google sign-in)
GOOGLE_CLIENT_ID=
# Development sign-in (any email, no Google) is on unless NODE_ENV=production. Set to 0 to hide it locally too.
DEV_LOGIN=1
# Max cash commission (INR) a driver can owe before they're blocked from going online
MAX_CASH_OWED_INR=3000
# Razorpay online payments (optional: leave empty for cash only). Use test-mode keys (rzp_test_...) while developing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when creating the webhook in the Razorpay Dashboard (see README → Razorpay)
RAZORPAY_WEBHOOK_SECRET=
DISPATCH_RADIUS_KM=15
OFFER_TIMEOUT_SEC=90
